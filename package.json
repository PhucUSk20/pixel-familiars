{
  "name": "pixel-pet-codex",
  "displayName": "Pixel Familiars",
  "description": "Animated pixel companions, magical summons and legendary pets for your AI workspace.",
  "author": "PhucUSk20",
  "publisher": "pixel-pet-local",
  "version": "0.19.7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PhucUSk20/pixel-familiars.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "pixelPet.openDeoxys",
        "title": "Pixel Familiars: Open Deoxys"
      },
      {
        "command": "pixelPet.openKyogre",
        "title": "Pixel Familiars: Open Primal Kyogre"
      },
      {
        "command": "pixelPet.openArena",
        "title": "Pixel Familiars: Open Legendary Arena"
      },
      {
        "command": "pixelPet.openGroudon",
        "title": "Pixel Pet: Open Primal Groudon"
      },
      {
        "command": "pixelPet.openLegendary",
        "title": "Pixel Pet: Open Legendary Pet"
      },
      {
        "command": "pixelPet.open",
        "title": "Pixel Pet: Open Companion"
      },
      {
        "command": "pixelPet.selectSession",
        "title": "Pixel Pet: Select Codex Session"
      },
      {
        "command": "pixelPet.importTheme",
        "title": "Pixel Pet: Import Theme"
      },
      {
        "command": "pixelPet.selectPet",
        "title": "Pixel Pet: Choose Pet"
      },
      {
        "command": "pixelPet.selectScene",
        "title": "Pixel Pet: Choose Scene"
      },
      {
        "command": "pixelPet.resetTheme",
        "title": "Pixel Pet: Reset to Slime"
      },
      {
        "command": "pixelPet.demo",
        "title": "Pixel Pet: Toggle Demo"
      },
      {
        "command": "pixelPet.setup",
        "title": "Pixel Pet: Set Up Codex Hooks and MCP"
      },
      {
        "command": "pixelPet.preview",
        "title": "Pixel Pet: Open Theme Preview"
      },
      {
        "command": "pixelPet.reviewHooks",
        "title": "Pixel Pet: Review Codex Hooks"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "pixelPetDeoxys",
          "title": "Deoxys",
          "icon": "media/pet.svg"
        },
        {
          "id": "pixelPetKyogre",
          "title": "Primal Kyogre",
          "icon": "media/pet.svg"
        },
        {
          "id": "pixelPetArena",
          "title": "Legendary Arena",
          "icon": "media/pet.svg"
        },
        {
          "id": "pixelPetGroudon",
          "title": "Primal Groudon",
          "icon": "media/pet.svg"
        },
        {
          "id": "pixelPet",
          "title": "Pixel Pet",
          "icon": "media/pet.svg"
        },
        {
          "id": "pixelPetLegendary",
          "title": "Legendary Pet",
          "icon": "media/pet.svg"
        }
      ]
    },
    "views": {
      "pixelPetGroudon": [
        {
          "type": "webview",
          "id": "pixelPet.groudon",
          "name": "Primal Groudon"
        }
      ],
      "pixelPetLegendary": [
        {
          "type": "webview",
          "id": "pixelPet.legendary",
          "name": "Legendary Pet"
        }
      ],
      "pixelPet": [
        {
          "type": "webview",
          "id": "pixelPet.companion",
          "name": "Codex Companion"
        }
      ],
      "pixelPetArena": [
        {
          "type": "webview",
          "id": "pixelPet.arena",
          "name": "Legendary Arena"
        }
      ],
      "pixelPetKyogre": [
        {
          "type": "webview",
          "id": "pixelPet.kyogre",
          "name": "Primal Kyogre"
        }
      ],
      "pixelPetDeoxys": [
        {
          "type": "webview",
          "id": "pixelPet.deoxys",
          "name": "Deoxys \u00b7 Meteorite Sanctuary"
        }
      ]
    },
    "configuration": {
      "title": "Pixel Pet",
      "properties": {
        "pixelPet.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Codex home directory. Empty uses CODEX_HOME or ~/.codex on the extension host."
        },
        "pixelPet.includeCli": {
          "type": "boolean",
          "default": false,
          "description": "Also observe CLI sessions in this workspace."
        },
        "pixelPet.showTargets": {
          "type": "boolean",
          "default": false,
          "description": "Show short tool targets. Leave off when sharing your screen."
        },
        "pixelPet.speed": {
          "type": "string",
          "enum": [
            "slow",
            "normal",
            "fast"
          ],
          "default": "normal"
        },
        "pixelPet.sleepAfter": {
          "type": "number",
          "minimum": 0,
          "default": 60,
          "description": "Idle seconds before sleeping while Mini rests. An awake Mini keeps the AI pet company with local interactions. Zero disables sleep."
        },
        "pixelPet.showHud": {
          "type": "boolean",
          "default": true
        },
        "pixelPet.themeFile": {
          "type": "string",
          "default": "",
          "description": "Optional theme JSON path, relative to the first workspace folder or absolute. Reloaded when saved."
        },
        "pixelPet.projectChecks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional required VS Code check task names. Empty follows observed Codex checks and VS Code build/test tasks automatically. Mini never launches commands."
        },
        "pixelPet.showMinis": {
          "type": "boolean",
          "default": true,
          "description": "Show minis for observed tool calls and subagent lifecycle events."
        },
        "pixelPet.showStatusLine": {
          "type": "boolean",
          "default": true,
          "description": "Show the pet's activity text."
        }
      }
    }
  },
  "scripts": {
    "install:codex": "node tools/codex/install-all.mjs",
    "build": "node tools/codex/build.mjs",
    "typecheck": "tsc -p tsconfig.codex.json",
    "test": "tsx --test extensions/codex/test/*.test.ts tools/codex/test/*.test.mjs",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "prepackage": "npm run typecheck && npm run build",
    "package": "node tools/codex/package.mjs",
    "test:ui": "node tools/codex/smoke.mjs",
    "record:codex-pets": "node tools/codex/record-pets.mjs",
    "record:legendary": "node tools/codex/record-legendary.mjs",
    "record:groudon": "node tools/codex/record-groudon.mjs",
    "diagnose": "tsx tools/codex/diagnose.ts",
    "setup": "tsx tools/codex/install.ts",
    "record:arena": "node tools/codex/record-arena.mjs",
    "record:kyogre": "node tools/codex/record-kyogre.mjs",
    "record:deoxys": "node tools/codex/record-deoxys.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.96.0",
    "fflate": "^0.8.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
